<div class="content-container">
<h1>Daily Entry</h1>
 <p>Hello, welcome to your daily entry page, </p>
  
  <p> Tell me about your day! </p>
    <p> What did you do? What was the best part? What was the worst part? </p>
      <p> How did you feel? Use the faces to describe your mood, which one lines up best with how you feel? </p>
 

 <%= form_with model: @daily_entry, url: daily_entries_path, data: { turbo: false } do |f| %>
     <%= render "shared/error_messages", object: @daily_entry %>
     
  <div class="input-field-day-content">
    <%= f.label :day_content, "Day Content" %>
    <%= f.text_area :day_content %>
  </div>

  <div class="input-field-mood"> 
    <%= f.label :mood, "Mood" %>
    <%= f.hidden_field :mood, id: "mood-field" %> 

    <button type="button" class="mood-face" data-mood="1">🙂</button>
    <button type="button" class="mood-face" data-mood="2">😐</button>
    <button type="button" class="mood-face" data-mood="3">😢</button>

    <%= f.submit "Submit" %>
    
    <p><%= link_to "All Entries", daily_entries_path %></p>
  </div>
<% end %>
</div>